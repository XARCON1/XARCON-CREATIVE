{
  "rewrites": [
    {
      "source": "/servicios",
      "destination": "/servicios/index.html"
    },
    {
      "source": "/soluciones",
      "destination": "/soluciones/index.html"
    },
    {
      "source": "/proceso",
      "destination": "/proceso/index.html"
    },
    {
      "source": "/nosotros",
      "destination": "/nosotros/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad/index.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/terminos-y-condiciones/index.html"
    },
    {
      "source": "/politica-de-cookies",
      "destination": "/politica-de-cookies/index.html"
    },
    {
      "source": "/aviso-legal",
      "destination": "/aviso-legal/index.html"
    },
    {
      "source": "/planes",
      "destination": "/planes/index.html"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/__review.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
