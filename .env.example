# Optional verified contact channel. Do not use invented addresses.
# The site prepares a downloadable brief when neither is configured.
VITE_CONTACT_EMAIL=
# International country code + number, digits only.
VITE_CONTACT_WHATSAPP=

# XARCON HQ / Firebase Web App configuration.
# Firebase web config is public client configuration; never place service-account secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
